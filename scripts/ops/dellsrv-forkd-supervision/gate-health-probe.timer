# =============================================================================
# gate-health-probe.timer — periodic trigger for gate-health-probe.service.
#
# CADENCE
#   5 minutes is a reasonable default: the original outage lasted 3
#   days silently, so even a 5-minute probe is a 1000x improvement.
#   Tighter cadences add load to the gate (each probe forks a real
#   sandbox and execs /bin/true) and risk contention with the
#   workload itself. Looser cadences extend the silent-failure
#   window. 5 minutes is the operator-judged middle.
#
#   Persistent=true so that a missed run (e.g. laptop sleep, the
#   timer was down for any reason) catches up as soon as the timer
#   comes back. Without Persistent=true, systemd drops missed
#   OnCalendar= runs entirely and the gate can be silent for a full
#   interval after a transient blip.
#
# ACCURACYSEC
#   Default to 60s so a fleet of timers (this and others) do not
#   stampede the gate at exactly :00, :05, :10, ...  Pick an offset
#   minute if you stack this with other timers.
#
# INDEPENDENCE
#   This timer triggers gate-health-probe.service. It does NOT
#   reference forkd-ec.service or forkd-controller.service in any
#   way. See INDEPENDENCE NOTE in gate-health-probe.service.
# =============================================================================

[Unit]
Description=Periodic forkd gate health probe (every 5 minutes)
Documentation=https://internal/forkd/probe

[Timer]
# Run 1 minute after boot, then every 5 minutes.
OnBootSec=1min
OnUnitActiveSec=5min
# AccuracySec=60s spreads the run a bit within the 5-min window so
# the probe does not collide with other periodic work on the gate.
AccuracySec=60s
# Persistent so a missed run catches up.
Persistent=true
Unit=gate-health-probe.service

[Install]
WantedBy=timers.target
